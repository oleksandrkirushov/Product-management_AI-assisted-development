{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: ProductCatalog.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProductCatalog.Api/bin/Debug/net10.0/ProductCatalog.Api.dll",
      "cwd": "${workspaceFolder}/src/ProductCatalog.Api",
      "stopAtEntry": false,
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
